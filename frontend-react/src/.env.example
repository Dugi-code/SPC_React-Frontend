# ─── Salary Progression Calculator — Environment Variables ───────────────────
#
# Copy this file to .env.local for local development.
# In Vercel: set these under Project → Settings → Environment Variables
#
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of your backend API (no trailing slash)
# Local:      http://localhost:8000
# Production: https://your-backend.railway.app  (or wherever deployed)
REACT_APP_API_URL=http://localhost:8000

# API authentication key sent as Bearer token
REACT_APP_API_KEY=CHANGEME
